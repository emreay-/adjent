{
  "name": "@adjent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Adjent desktop shell: tray, popover panel, native toasts.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "test": "vitest run",
    "dist": "electron-builder --config electron-builder.yml",
    "icons": "electron scripts/make-icons.cjs"
  },
  "dependencies": {
    "@adjent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
