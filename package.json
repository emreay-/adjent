{
  "name": "adjent-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Tray-resident monitor for local AI coding agents: live agents, models, quota utilization, and pace alarms.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "status": "pnpm --filter @adjent/cli start status",
    "watch": "pnpm --filter @adjent/cli start watch"
  }
}
